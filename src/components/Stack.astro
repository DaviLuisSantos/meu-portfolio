---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section class="border-b border-border bg-surface/40">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="font-mono text-xs tracking-widest text-muted uppercase">// {t('stack.title')}</p>
    <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        profile.stack.map((group) => (
          <div>
            <p class="font-mono text-xs text-cobalt">{group.label[lang]}</p>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-2 font-mono text-sm">
              {group.items.map((item) => (
                <li class="inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
                  {item.icon ? (
                    <Icon name={item.icon} class="size-4" />
                  ) : (
                    <span class="size-1.5 rounded-full bg-violet" aria-hidden="true" />
                  )}
                  {item.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
