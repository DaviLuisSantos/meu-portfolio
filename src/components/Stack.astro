---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section class="border-y border-border bg-surface/40">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:gap-8 sm:px-6">
    <p class="shrink-0 font-mono text-xs tracking-widest text-muted uppercase">// {t('stack.title')}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm">
      {
        profile.stack.map((item) => (
          <li class="inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
            <Icon name={item.icon} class="size-4" />
            {item.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
