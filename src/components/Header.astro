---
import type { Lang } from '../i18n/ui';
import { otherLang, paths, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const t = useTranslations(lang);
const home = paths.home(lang);
const links = [
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/75 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 font-mono text-xs sm:px-6 sm:text-sm">
    <a href={home} class="group flex items-center gap-2 tracking-widest uppercase">
      <span class="text-split transition-transform group-hover:rotate-45">◆</span>
      <span>Davi Luis</span>
    </a>
    <div class="flex items-center gap-0.5 sm:gap-2">
      {
        links.map((link) => (
          <a href={link.href} class="hidden rounded px-2 py-1.5 text-muted transition-colors hover:text-fg min-[420px]:inline-block sm:px-3">
            {link.label}
          </a>
        ))
      }
      <span class="mx-1 hidden h-4 w-px bg-border min-[420px]:block"></span>
      <a
        href={alternate}
        hreflang={otherLang(lang)}
        title={t('nav.switch')}
        aria-label={t('nav.switch')}
        class="rounded px-2 py-1.5 text-muted transition-colors hover:text-fg"
      >
        <span class="text-fg">{lang}</span><span class="mx-1 text-border">/</span>{otherLang(lang)}
      </a>
    </div>
  </nav>
</header>
