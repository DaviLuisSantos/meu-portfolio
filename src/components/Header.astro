---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { otherLang, paths, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const t = useTranslations(lang);
const home = paths.home(lang);
const links = [
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="font-semibold tracking-tight">Davi Luis</a>
    <div class="flex items-center gap-1 text-sm sm:gap-2">
      {
        links.map((link) => (
          <a href={link.href} class="rounded-md px-2 py-1.5 text-muted transition-colors hover:text-fg sm:px-3">
            {link.label}
          </a>
        ))
      }
      <a
        href={alternate}
        hreflang={otherLang(lang)}
        title={t('nav.switch')}
        aria-label={t('nav.switch')}
        class="ml-1 inline-flex items-center gap-1 rounded-md border border-border px-2 py-1.5 font-medium uppercase transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name="lucide:languages" class="size-4" />
        {otherLang(lang)}
      </a>
    </div>
  </nav>
</header>
