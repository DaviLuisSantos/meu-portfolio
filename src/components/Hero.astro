---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import profilePic from '../assets/profile.jpg';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { paths, useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section class="relative overflow-hidden">
  <div class="split-light"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-20 pb-24 sm:px-6 sm:pt-28 sm:pb-32 md:grid-cols-[1fr_auto]">
    <div>
      <p class="rise font-mono text-sm text-cobalt" style="--delay: 0s">
        <span class="text-muted">&gt;</span> {profile.name.toLowerCase()} · {t('hero.kicker')}
      </p>
      <h1 class="rise mt-6 font-serif text-6xl leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl" style="--delay: 0.1s">
        {t('hero.title.1')}<br />
        <em class="text-split pr-2">{t('hero.title.2')}</em>
      </h1>
      <p class="rise mt-8 max-w-xl text-lg text-pretty text-muted" style="--delay: 0.2s">{t('hero.tagline')}</p>
      <p class="rise mt-4 font-mono text-xs text-muted sm:text-sm" style="--delay: 0.25s">// {t('hero.meta')}</p>

      <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--delay: 0.3s">
        <a href={paths.resume(lang)} data-resume-open class="btn-glow inline-flex items-center gap-2 rounded-md px-5 py-3 font-medium">
          <Icon name="lucide:file-text" class="size-4" />
          {t('hero.resume')}
        </a>
        <a href="#projects" class="inline-flex items-center gap-2 rounded-md px-5 py-3 font-medium text-muted transition-colors hover:text-fg">
          {t('hero.projects')} <span aria-hidden="true">↓</span>
        </a>
      </div>

      <ul class="rise mt-10 flex gap-5" style="--delay: 0.4s">
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="text-muted transition-colors hover:text-fg">
                <Icon name={s.icon} class="size-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rise order-first md:order-none" style="--delay: 0.15s">
      <Image
        src={profilePic}
        alt={profile.name}
        width={320}
        height={320}
        densities={[1, 2]}
        loading="eager"
        class="split-portrait size-44 rounded-2xl object-cover sm:size-56 lg:size-80"
      />
    </div>
  </div>

  <!-- Números que contam a história em cinco segundos. -->
  <dl class="relative mx-auto grid max-w-6xl grid-cols-2 gap-px border-y border-border bg-border lg:grid-cols-4">
    {
      profile.facts.map((fact, i) => (
        <div class="rise flex flex-col-reverse bg-bg px-4 py-6 sm:px-6" style={`--delay: ${0.45 + i * 0.05}s`}>
          <dt class="mt-2 text-sm text-pretty text-muted">{fact.label[lang]}</dt>
          <dd class="font-serif text-4xl text-split sm:text-5xl">{fact.value[lang]}</dd>
        </div>
      ))
    }
  </dl>
</section>
