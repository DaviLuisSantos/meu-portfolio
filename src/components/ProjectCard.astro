---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { paths, useTranslations } from '../i18n/utils';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const { title, summary, tags, cover, repo, demo, links, draft } = project.data;
const t = useTranslations(lang);
const hasDetails = Boolean(project.body?.trim());
---

<article class="reveal flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-accent/60">
  {cover && <Image src={cover} alt="" widths={[400, 800]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-video w-full object-cover" />}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold">
      {title}
      {draft && <span class="ml-2 rounded bg-amber-500/15 px-1.5 py-0.5 align-middle text-xs font-medium text-amber-600">draft</span>}
    </h3>
    <p class="mt-2 flex-1 text-muted">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="rounded-md bg-bg px-2 py-0.5 text-xs text-muted">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
      {
        hasDetails && (
          <a href={paths.project(lang, projectSlug(project))} class="text-accent hover:underline">
            {t('projects.details')}
          </a>
        )
      }
      {
        repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-accent">
            <Icon name="simple-icons:github" class="size-4" /> {t('projects.repo')}
          </a>
        )
      }
      {
        demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-accent">
            <Icon name="lucide:arrow-up-right" class="size-4" /> {t('projects.demo')}
          </a>
        )
      }
      {
        links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-accent">
            <Icon name="lucide:external-link" class="size-4" /> {link.label}
          </a>
        ))
      }
    </div>
  </div>
</article>
