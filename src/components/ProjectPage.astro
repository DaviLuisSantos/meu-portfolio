---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n/ui';
import { otherLang, paths, useTranslations } from '../i18n/utils';
import { getProjects, projectSlug, type Project } from '../lib/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const { title, summary, highlight, tags, cover, repo, demo, links } = project.data;
const t = useTranslations(lang);
const { Content } = await render(project);

// Se não houver tradução deste projeto, o seletor de idioma leva à home do outro idioma.
const other = otherLang(lang);
const slug = projectSlug(project);
const translated = (await getProjects(other)).some((p) => projectSlug(p) === slug);
const alternate = translated ? paths.project(other, slug) : paths.home(other);

const external = [
  repo && { label: t('projects.repo'), href: repo, icon: 'simple-icons:github' },
  demo && { label: t('projects.demo'), href: demo, icon: 'lucide:arrow-up-right' },
  ...links.map((l) => ({ ...l, icon: 'lucide:arrow-up-right' })),
].filter(Boolean) as { label: string; href: string; icon: string }[];
---

<Layout lang={lang} alternate={alternate} title={title} description={summary}>
  <article>
    <header class="relative overflow-hidden border-b border-border">
      <div class="split-light opacity-70"></div>
      <div class="relative mx-auto max-w-3xl px-4 pt-12 pb-14 sm:px-6 sm:pt-16">
        <a href={`${paths.home(lang)}#projects`} class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-fg">
          <Icon name="lucide:arrow-left" class="size-3.5" />
          {t('projects.back')}
        </a>
        <h1 class="rise mt-8 font-serif text-5xl leading-tight sm:text-6xl">{title}</h1>
        {highlight && <p class="rise mt-3 font-mono text-sm text-cobalt" style="--delay: 0.1s">{highlight}</p>}
        <p class="rise mt-6 text-lg text-pretty text-muted" style="--delay: 0.15s">{summary}</p>

        <div class="rise mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs" style="--delay: 0.2s">
          {
            external.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-fg/80 transition-colors hover:text-cobalt">
                <Icon name={link.icon} class="size-3.5" /> {link.label}
              </a>
            ))
          }
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      {cover && <Image src={cover} alt="" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" class="mb-12 w-full rounded-lg border border-border" />}
      <div
        class="prose prose-lg max-w-none prose-invert prose-headings:font-serif prose-headings:font-normal prose-h2:text-4xl prose-a:text-cobalt prose-strong:text-fg prose-code:font-mono prose-code:text-violet prose-code:before:content-none prose-code:after:content-none prose-blockquote:border-violet prose-blockquote:font-serif prose-blockquote:text-xl prose-li:marker:text-cobalt"
      >
        <Content />
      </div>
    </div>
  </article>
</Layout>
