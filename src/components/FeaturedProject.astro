---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { paths, useTranslations } from '../i18n/utils';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  lang: Lang;
  project: Project;
  index: number;
  /** Ocupa a largura toda da grade. */
  wide?: boolean;
}

const { lang, project, index, wide = false } = Astro.props;
const { title, summary, highlight, tags, repo, demo, links } = project.data;
const t = useTranslations(lang);
const href = project.body?.trim() ? paths.project(lang, projectSlug(project)) : null;
const number = String(index + 1).padStart(2, '0');
const metrics = highlight?.split(' · ') ?? [];

const external = [
  repo && { label: t('projects.repo'), href: repo, icon: 'simple-icons:github' },
  demo && { label: t('projects.demo'), href: demo, icon: 'lucide:arrow-up-right' },
  ...links.map((l) => ({ ...l, icon: 'lucide:arrow-up-right' })),
].filter(Boolean) as { label: string; href: string; icon: string }[];
---

<article
  class:list={[
    'reveal group relative overflow-hidden rounded-xl border border-border bg-surface/40 p-6 transition-colors duration-500 hover:border-cobalt/50 sm:p-8',
    wide && 'lg:col-span-2 lg:p-12',
  ]}
>
  <div class="split-light opacity-30 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>

  <div class="relative flex h-full flex-col">
    <p class="flex items-center justify-between font-mono text-xs">
      <span class="text-cobalt">{number}</span>
      <span class="tracking-widest text-muted uppercase">{t('projects.featured')}</span>
    </p>

    <h3 class:list={['mt-6 font-serif leading-[1.05]', wide ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-4xl sm:text-5xl']}>
      {
        href ? (
          <a href={href} class="after:absolute after:inset-0 after:content-['']">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    {
      metrics.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
          {metrics.map((m) => (
            <li class="rounded-full border border-cobalt/30 bg-bg/60 px-3 py-1 text-cobalt">{m}</li>
          ))}
        </ul>
      )
    }

    <p class:list={['mt-6 text-pretty text-muted', wide && 'max-w-3xl text-lg']}>{summary}</p>

    <div class="mt-auto pt-8">
      <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-border/70 pt-5 font-mono text-xs">
        <ul class="relative z-10 flex flex-wrap gap-x-4 gap-y-2">
          {
            external.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-fg/80 transition-colors hover:text-cobalt">
                  <Icon name={link.icon} class="size-3.5" /> {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          href && (
            <span class="text-muted transition-colors group-hover:text-fg">
              {t('projects.details')} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </span>
          )
        }
      </div>
    </div>
  </div>
</article>
