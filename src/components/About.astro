---
import SectionLabel from './SectionLabel.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="about" class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionLabel index="02" label={t('about.title')} />
  <div class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <blockquote class="font-serif text-4xl leading-tight text-pretty sm:text-5xl">
      <span class="text-split">“</span>{t('about.lead')}<span class="text-split">”</span>
    </blockquote>
    <div class="space-y-5 text-lg text-pretty text-muted lg:pt-3">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
    </div>
  </div>
</section>
