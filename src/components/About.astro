---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="about" class="reveal mx-auto max-w-5xl px-4 pb-24 sm:px-6">
  <h2 class="text-3xl font-bold tracking-tight">{t('about.title')}</h2>
  <div class="mt-6 max-w-2xl space-y-4 text-lg text-pretty text-muted">
    <p>{t('about.p1')}</p>
    <p>{t('about.p2')}</p>
  </div>
</section>
