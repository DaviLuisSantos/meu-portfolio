---
import SectionLabel from './SectionLabel.astro';
import type { Lang } from '../i18n/ui';
import { paths, useTranslations } from '../i18n/utils';
import { experience } from '../data/experience';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="experience" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6 sm:pt-32">
  <div class="reveal">
    <SectionLabel index="01" label={t('experience.title')} />
  </div>
  <div class="mt-8 border-b border-border">
    {
      experience.map((role) => (
        <article class="reveal grid gap-x-8 gap-y-3 border-t border-border py-8 sm:grid-cols-[12rem_1fr]">
          <p class="font-mono text-sm text-muted">{role.period[lang]}</p>
          <div>
            <h3 class="font-serif text-2xl leading-tight sm:text-3xl">
              {role.title[lang]} <span class="text-muted">· {role.company}</span>
            </h3>
            {role.earlier && <p class="mt-1 font-mono text-xs text-muted">{role.earlier[lang]}</p>}
            <p class="mt-3 max-w-3xl text-pretty text-muted">{role.summary[lang]}</p>
            {role.highlights && (
              <ul class="mt-4 max-w-3xl space-y-2 text-pretty">
                {role.highlights[lang].map((h) => (
                  <li class="relative pl-5 text-fg/85 before:absolute before:top-2.5 before:left-0 before:size-1.5 before:rounded-full before:bg-cobalt">
                    {h}
                  </li>
                ))}
              </ul>
            )}
            {role.project && (
              <a href={paths.project(lang, role.project)} class="mt-3 inline-block font-mono text-xs text-cobalt hover:underline">
                {t('experience.work')} →
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
