---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="contact" class="reveal mx-auto max-w-5xl px-4 pb-24 sm:px-6">
  <div class="rounded-2xl border border-border bg-surface p-8 sm:p-12">
    <h2 class="text-3xl font-bold tracking-tight">{t('contact.title')}</h2>
    <p class="mt-4 max-w-xl text-lg text-pretty text-muted">{t('contact.text')}</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        profile.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 font-medium transition-colors hover:border-accent hover:text-accent"
            >
              <Icon name={s.icon} class="size-4" />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
