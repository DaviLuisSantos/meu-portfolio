---
import { Icon } from 'astro-icon/components';
import SectionLabel from './SectionLabel.astro';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { paths, useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="contact" class="reveal mx-auto max-w-6xl px-4 pt-16 pb-32 sm:px-6">
  <SectionLabel index={profile.youtube ? '04' : '03'} label={t('contact.title')} />
  <h2 class="mt-6 font-serif text-6xl sm:text-8xl">
    <em class="text-split pr-3">{t('contact.heading')}</em>
  </h2>
  <p class="mt-6 max-w-xl text-lg text-pretty text-muted">{t('contact.text')}</p>
  <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-4 font-mono text-sm">
    {
      profile.socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
            <Icon name={s.icon} class="size-4" />
            {s.label.toLowerCase()}
            <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
          </a>
        </li>
      ))
    }
    <li>
      <a href={paths.resume(lang)} data-resume-open class="group inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
        <Icon name="lucide:file-text" class="size-4" />
        {t('hero.resume').toLowerCase()}
      </a>
    </li>
  </ul>
</section>
