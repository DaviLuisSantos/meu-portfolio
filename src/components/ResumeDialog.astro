---
import { Icon } from 'astro-icon/components';
import ResumeForm from './ResumeForm.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<dialog
  id="resume-dialog"
  aria-labelledby="resume-title"
  class="m-auto w-[min(32rem,calc(100%-2rem))] overflow-visible rounded-lg border border-border bg-bg p-0 text-fg backdrop:bg-black/80 backdrop:backdrop-blur-sm"
>
  <div class="relative overflow-hidden rounded-lg p-6 sm:p-8">
    <div class="split-light opacity-60"></div>
    <div class="relative">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-mono text-xs text-cobalt">// cv.pdf</p>
          <h2 id="resume-title" class="mt-1 font-serif text-3xl">{t('resume.title')}</h2>
        </div>
        <button type="button" data-resume-close aria-label={t('resume.close')} class="rounded-md p-1 text-muted transition-colors hover:text-fg">
          <Icon name="lucide:x" class="size-5" />
        </button>
      </div>
      <p class="mt-3 mb-6 text-sm text-muted">{t('resume.intro')}</p>

      <div data-resume-body>
        <ResumeForm lang={lang} />
      </div>

      <div data-resume-done class="hidden py-6 text-center">
        <p class="font-serif text-3xl text-split">{t('resume.success')}</p>
        <a data-resume-again class="mt-3 inline-block font-mono text-sm text-muted underline-offset-4 hover:text-fg hover:underline">
          {t('resume.success.again')}
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  // Sem JavaScript, o botão leva à página /curriculo com o mesmo formulário.
  const dialog = document.querySelector<HTMLDialogElement>('#resume-dialog')!;
  const body = dialog.querySelector<HTMLElement>('[data-resume-body]')!;
  const done = dialog.querySelector<HTMLElement>('[data-resume-done]')!;
  const again = dialog.querySelector<HTMLAnchorElement>('[data-resume-again]')!;

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest('[data-resume-open]');
    if (!trigger) return;
    event.preventDefault();
    dialog.showModal();
  });

  dialog.querySelector('[data-resume-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close(); // clique no fundo
  });

  // Vale para o modal e para a página /curriculo.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-resume-form]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const error = form.querySelector<HTMLElement>('[data-resume-error]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const showError = (message: string) => {
        error.textContent = message;
        error.classList.remove('hidden');
      };

      error.classList.add('hidden');
      button.disabled = true;
      button.textContent = form.dataset.msgSending!;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'x-resume-fetch': '1' },
        });
        if (!res.ok) {
          const { error: code } = await res.json().catch(() => ({ error: 'network' }));
          showError(code === 'rate' ? form.dataset.msgRate! : code === 'invalid' ? form.dataset.msgInvalid! : form.dataset.msgNetwork!);
          return;
        }

        const filename = /filename="([^"]+)"/.exec(res.headers.get('content-disposition') ?? '')?.[1] ?? 'curriculo.pdf';
        const url = URL.createObjectURL(await res.blob());
        const link = Object.assign(document.createElement('a'), { href: url, download: filename });
        link.click();
        again.href = url;
        again.download = filename;

        if (form.closest('dialog')) {
          body.classList.add('hidden');
          done.classList.remove('hidden');
        } else {
          form.replaceWith(Object.assign(document.createElement('p'), { className: 'font-serif text-3xl text-split', textContent: done.querySelector('p')!.textContent }));
        }
      } catch {
        showError(form.dataset.msgNetwork!);
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label!;
      }
    });
  }
</script>
