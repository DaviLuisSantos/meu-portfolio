---
import Layout from '../layouts/Layout.astro';
import ResumeForm from './ResumeForm.astro';
import type { Lang } from '../i18n/ui';
import { otherLang, paths, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Usada quando o JavaScript está desligado ou o link é aberto direto. -->
<Layout lang={lang} alternate={paths.resume(otherLang(lang))} title={t('resume.title')}>
  <section class="relative overflow-hidden">
    <div class="split-light"></div>
    <div class="relative mx-auto max-w-xl px-4 py-20 sm:px-6">
      <p class="font-mono text-xs text-cobalt">// cv.pdf</p>
      <h1 class="mt-2 font-serif text-5xl">{t('resume.title')}</h1>
      <p class="mt-4 mb-10 text-muted">{t('resume.intro')}</p>
      <ResumeForm lang={lang} idPrefix="page" error={Astro.url.searchParams.get('erro')} />
    </div>
  </section>
</Layout>
