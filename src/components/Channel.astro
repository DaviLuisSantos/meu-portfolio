---
import { Icon } from 'astro-icon/components';
import SectionLabel from './SectionLabel.astro';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

{
  profile.youtube && (
    <section class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <SectionLabel index="04" label={t('channel.title')} />
      <div class="relative mt-8 overflow-hidden rounded-lg border border-border p-8 sm:p-12">
        <div class="split-light opacity-70" />
        <div class="relative flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <div class="max-w-xl">
            <p class="font-mono text-sm text-cobalt">Davi Dev</p>
            <h2 class="mt-3 font-serif text-4xl sm:text-5xl">{t('channel.heading')}</h2>
            <p class="mt-4 text-muted">{t('channel.text')}</p>
          </div>
          <a
            href={profile.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-glow inline-flex shrink-0 items-center gap-2 self-start rounded-md px-5 py-3 font-medium md:self-auto"
          >
            <Icon name="simple-icons:youtube" class="size-4" />
            {t('channel.cta')}
          </a>
        </div>
      </div>
    </section>
  )
}
