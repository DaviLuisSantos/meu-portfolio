---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');
---

<Layout lang="pt" alternate="/en/" title={t('notfound.title')}>
  <section class="relative overflow-hidden">
    <div class="split-light"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-40 text-center sm:px-6">
      <p class="font-serif text-9xl text-split">404</p>
      <h1 class="mt-4 font-mono text-sm text-muted">{t('notfound.title')}</h1>
      <a href="/" class="mt-10 inline-block font-mono text-sm text-fg underline-offset-4 hover:underline">← {t('notfound.back')}</a>
    </div>
  </section>
</Layout>
