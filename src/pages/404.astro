---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');
---

<Layout lang="pt" alternate="/en/" title={t('notfound.title')}>
  <section class="mx-auto max-w-5xl px-4 py-32 text-center sm:px-6">
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{t('notfound.title')}</h1>
    <a href="/" class="mt-8 inline-block font-medium text-accent hover:underline">{t('notfound.back')}</a>
  </section>
</Layout>
