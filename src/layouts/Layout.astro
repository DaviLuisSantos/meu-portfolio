---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import { otherLang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Mesma página no outro idioma. */
  alternate: string;
  title?: string;
  description?: string;
}

const { lang, alternate, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · Davi Luis` : 'Davi Luis · ' + t('hero.role');
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('meta.description')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t('meta.description')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={otherLang(lang)} href={new URL(alternate, Astro.site)} />
  </head>
  <body class="min-h-dvh">
    <Header lang={lang} alternate={alternate} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
